{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window access to user-selected multi-document files and local recovery data",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "**" }] }
  ]
}
