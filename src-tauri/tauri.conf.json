{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free MD Viewer",
  "version": "0.1.0",
  "identifier": "com.kingsbridge.freedmdviewer",
  "build": {
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Free MD Viewer",
        "width": 1280,
        "height": 840,
        "minWidth": 700,
        "minHeight": 480,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
