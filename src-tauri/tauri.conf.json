{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDedit",
  "version": "0.3.1",
  "identifier": "com.skanga.mdedit",
  "build": {
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "MDedit",
        "width": 1280,
        "height": 840,
        "minWidth": 700,
        "minHeight": 480,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      { "ext": ["md", "markdown", "mdown", "mkd"], "name": "Markdown", "description": "Markdown document", "role": "Editor" }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
