{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDedit",
  "version": "0.3.16",
  "identifier": "com.skanga.mdedit",
  "build": {
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "MDedit",
        "width": 1280,
        "height": 840,
        "minWidth": 700,
        "minHeight": 480,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      { "ext": ["md", "markdown", "mdown", "mkd"], "name": "Markdown", "description": "Markdown document", "role": "Editor" }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
